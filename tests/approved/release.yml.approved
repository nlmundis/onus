name: release

# Push a tag like v0.1.0 on a commit already on main, after setting onus.__version__ to the same number. The
# full gate runs on that commit; only if it passes are the tag and version checked, and the sdist and wheel
# built, checked by the same tools/check_dist.py the gate runs, and attached to a GitHub Release. Nothing is
# uploaded to PyPI. Every v* tag starts this workflow, the tags the release-tags ruleset makes permanent, so a
# tag of any other shape is refused here, visibly, rather than ignored.
on:
  push:
    tags: ["v*"]

permissions:
  contents: read

jobs:
  checks:
    uses: ./.github/workflows/check.yml

  release:
    needs: checks
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: actions/setup-python@v5
        with:
          python-version: "3.13"
      - uses: astral-sh/setup-uv@v6
      - name: Refuse a tag that is not a release of main
        run: |
          git fetch --no-tags origin main
          version="$(python -c 'import onus; print(onus.__version__)')"
          refused=0
          git merge-base --is-ancestor "$GITHUB_SHA" FETCH_HEAD \
            || { echo "::error::$GITHUB_REF_NAME is not on main."; refused=1; }
          test "v$version" = "$GITHUB_REF_NAME" \
            || { echo "::error::$GITHUB_REF_NAME does not match onus.__version__, which is $version."; refused=1; }
          if [ "$refused" -ne 0 ]; then
            echo "::error::Release tags are permanent (the release-tags ruleset), so $GITHUB_REF_NAME is spent. In a PR, set onus.__version__ to the next unused version and merge it to main; then tag that merge commit v<that version>."
            exit 1
          fi
      - name: Build the sdist and wheel, and check them as the gate does
        run: |
          python tools/check_dist.py --build --version "${GITHUB_REF_NAME#v}" dist \
            || { echo "::error::The artifacts for $GITHUB_REF_NAME failed the checks above, and release tags are permanent (the release-tags ruleset), so $GITHUB_REF_NAME is spent. Fix the packaging in a PR, set onus.__version__ to the next unused version, merge it to main, and tag that merge commit v<that version>."; exit 1; }
      - name: Create the GitHub Release
        env:
          GH_TOKEN: ${{ github.token }}
        run: gh release create "$GITHUB_REF_NAME" dist/* --verify-tag --generate-notes --title "$GITHUB_REF_NAME"
